# Corporate Knowledge Portal — environment example
# Copy to `.env.local` for local development. Do not commit real secrets.
# See docs/config/ENVIRONMENT.md

# Node runtime mode (usually set by Next.js / the host)
# NODE_ENV=development

# Logical environment label (optional)
# APP_ENV=development

# Logging verbosity (optional): debug | info | warn | error
# LOG_LEVEL=debug

# Public content read source (server-only): empty | demo | firestore
# development/test default: demo
# production default: empty
# demo is FORBIDDEN when NODE_ENV=production
# CONTENT_SOURCE_MODE=demo

# Auth mode (server-only): disabled | firebase
# Default: disabled (public site works; admin sign-in unavailable)
# AUTH_MODE=disabled

# Persistence mode (server-only): memory | firestore
# memory is TEST_ONLY / explicit local smoke — forbidden in production
# PERSISTENCE_MODE=firestore

# Optional absolute site origin for canonical URLs, sitemap, Origin checks
# SITE_URL=https://knowledge.example.com

# --- Firebase Admin (server secrets — never NEXT_PUBLIC_*) ---
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIRESTORE_DATABASE_ID=(default)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Exact admin emails (comma-separated). No wildcards / domain-only entries.
# Required when AUTH_MODE=firebase
# ADMIN_EMAIL_ALLOWLIST=admin@example.com

# Session (defaults: 8h max age; production cookie __Host-ckp_admin_session)
# ADMIN_SESSION_MAX_AGE_SECONDS=28800
# ADMIN_SESSION_COOKIE_NAME=ckp_admin_session
# CSRF_COOKIE_NAME=ckp_csrf

# --- Public Firebase client config (Auth only; no Admin secrets) ---
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Public app display name (optional; baked into the client bundle)
# NEXT_PUBLIC_APP_NAME=Corporate Knowledge Portal

# --- Google Workspace (server-only; ADC on Cloud Run; no keys in repo) ---
# GOOGLE_WORKSPACE_MODE=disabled
# GOOGLE_WORKSPACE_PROJECT_ID=
# GOOGLE_WORKSPACE_SHARED_DRIVE_ID=
# GOOGLE_WORKSPACE_ROOT_FOLDER_ID=
# GOOGLE_WORKSPACE_ALLOWED_FOLDER_IDS=
# GOOGLE_WORKSPACE_MAX_FILE_SIZE_BYTES=26214400
# GOOGLE_WORKSPACE_IMPORT_PREVIEW_TTL_SECONDS=3600
# GOOGLE_WORKSPACE_REQUEST_TIMEOUT_MS=30000
# GOOGLE_WORKSPACE_MAX_RETRY_ATTEMPTS=3

# --- Media Library (Phase 7B; server-only; never NEXT_PUBLIC_*) ---
# Production: MEDIA_STORAGE_MODE=gcs is REQUIRED (no silent fallback; memory forbidden).
# Non-production default when unset: memory in test / without bucket, else gcs.
# MEDIA_STORAGE_MODE=memory|gcs
# MEDIA_GCS_BUCKET=
# FIREBASE_STORAGE_BUCKET=
# MEDIA_SIGNED_UPLOAD_TTL_SECONDS=900  (bounded 60..3600)
# MEDIA_IMAGE_MAX_BYTES=5242880        (bounded 1024..20971520)
# MEDIA_DOCUMENT_MAX_BYTES=15728640    (bounded 1024..52428800)

# --- Search Foundation (Phase 8B.1; server-only; never NEXT_PUBLIC_*) ---
# Production: SEARCH_INDEX_MODE=gcs is REQUIRED (memory forbidden).
# SEARCH_INDEX_BUCKET is REQUIRED for gcs — set explicitly (may equal the media
# bucket by deliberate choice; there is no silent MEDIA_GCS_BUCKET fallback).
# SEARCH_CURSOR_HMAC_SECRET is REQUIRED in production (min 32 chars), shared by
# all instances; never generate per-process and never log.
# Non-production default mode when unset: memory.
# SEARCH_INDEX_MODE=memory|gcs
# SEARCH_INDEX_BUCKET=
# SEARCH_INDEX_PREFIX=search
# SEARCH_INDEX_CACHE_TTL_SECONDS=30
# SEARCH_QUERY_MAX_LENGTH=120
# SEARCH_PAGE_MAX_SIZE=50
# SEARCH_INDEX_MAX_DOCUMENTS=5000
# SEARCH_INDEX_MAX_BYTES=26214400
# SEARCH_DOCUMENT_MAX_CHARACTERS=20000
# SEARCH_CURSOR_HMAC_SECRET=

# --- Knowledge Assistant Foundation (Phase 8C.1; server-only; never NEXT_PUBLIC_*) ---
# Production default: disabled (fail-closed). No real LLM provider in 8C.1.
# ASSISTANT_MODE=fake is forbidden in production (test/local deterministic adapter only).
# ASSISTANT_MODE=disabled|fake
# Optional bounded overrides (invalid values fail closed):
# ASSISTANT_QUESTION_MAX_LENGTH=500
# ASSISTANT_MAX_RETRIEVAL_CANDIDATES=24
# ASSISTANT_MAX_SOURCES=6
# ASSISTANT_MAX_CHUNKS_PER_SOURCE=4
# ASSISTANT_MAX_CHUNK_CHARACTERS=1200
# ASSISTANT_MAX_EVIDENCE_CHARACTERS=8000
# ASSISTANT_MAX_ANSWER_BLOCKS=8
# ASSISTANT_MAX_ANSWER_CHARACTERS=4000
# ASSISTANT_MAX_CITATIONS=8
# ASSISTANT_PROVIDER_TIMEOUT_MS=12000
# ASSISTANT_APPLICATION_TIMEOUT_MS=20000
# ASSISTANT_REQUEST_BODY_MAX_BYTES=8192
# ASSISTANT_RATE_LIMIT_PER_WINDOW=10
# ASSISTANT_MAX_CONCURRENT_REQUESTS=2
# ASSISTANT_HYDRATION_BATCH_SIZE=20
# Intentionally NOT present in 8C.1:
# - ASSISTANT_API_KEY / ASSISTANT_API_URL / ASSISTANT_MODEL / ASSISTANT_PROVIDER
# - NEXT_PUBLIC_ASSISTANT_*

# -----------------------------------------------------------------------------
# Intentionally NOT configured yet (later phases):
# - Dedicated CSRF signing secret (Phase 5A derives material from project/site)
# - Phase 6B automatic sync / Cloud Scheduler
# - CDN / orphan sweeper / antivirus
# - Phase 8C.2 Assistant Experience UI
# - Production LLM provider adapter + distributed rate limiting
# -----------------------------------------------------------------------------
# Cloud Storage credentials: use ADC on Cloud Run (same as Firestore Admin).
# Do not commit service-account JSON.
# -----------------------------------------------------------------------------
